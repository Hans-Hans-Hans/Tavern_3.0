@@ -0,0 +1,88 @@
+// Copyright 2026 Tavern contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+package auth
+
+import (
+	"encoding/json"
+	"github.com/livekit/protocol/livekit"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/encoding/protojson"
+	"google.golang.org/protobuf/proto"
+	"testing"
+)
+
+func TestTavernAudioGrantPreservesOmittedPermissionUpdates(t *testing.T) {
+	grant := &VideoGrant{}
+	require.True(t, grant.GetTavernCanSubscribeAudio())
+	require.Nil(t, grant.ToPermission().TavernCanSubscribeAudio)
+	denied := grant.ToPermission()
+	denied.TavernCanSubscribeAudio = proto.Bool(false)
+	require.False(t, grant.MatchesPermission(denied))
+	grant.UpdateFromPermission(denied)
+	require.False(t, grant.GetTavernCanSubscribeAudio())
+	require.True(t, grant.MatchesPermission(denied))
+
+	oldClientUpdate := grant.ToPermission()
+	oldClientUpdate.TavernCanSubscribeAudio = nil
+	oldClientUpdate.CanPublishData = false
+	grant.UpdateFromPermission(oldClientUpdate)
+	require.False(t, grant.GetTavernCanSubscribeAudio())
+	require.True(t, grant.MatchesPermission(oldClientUpdate))
+	restore := grant.ToPermission()
+	restore.TavernCanSubscribeAudio = proto.Bool(true)
+	grant.UpdateFromPermission(restore)
+	require.True(t, grant.GetTavernCanSubscribeAudio())
+}
+
+func TestTavernAudioGrantCloneAndWirePresence(t *testing.T) {
+	for _, value := range []*bool{nil, proto.Bool(false), proto.Bool(true)} {
+		grant := &VideoGrant{TavernCanSubscribeAudio: value}
+		cloned := grant.Clone()
+		require.Equal(t, grant, cloned)
+		if value != nil {
+			require.NotSame(t, value, cloned.TavernCanSubscribeAudio)
+		}
+		permission := grant.ToPermission()
+		if value != nil {
+			require.NotSame(t, value, permission.TavernCanSubscribeAudio)
+		}
+		encoded, err := protojson.Marshal(permission)
+		require.NoError(t, err)
+		decoded := &livekit.ParticipantPermission{}
+		require.NoError(t, protojson.Unmarshal(encoded, decoded))
+		require.Equal(t, value, decoded.TavernCanSubscribeAudio)
+		wire, err := proto.Marshal(permission)
+		require.NoError(t, err)
+		require.NoError(t, proto.Unmarshal(wire, decoded))
+		require.Equal(t, value, decoded.TavernCanSubscribeAudio)
+		jwtJSON, err := json.Marshal(grant)
+		require.NoError(t, err)
+		var roundtrip VideoGrant
+		require.NoError(t, json.Unmarshal(jwtJSON, &roundtrip))
+		require.Equal(t, value, roundtrip.TavernCanSubscribeAudio)
+	}
+}
+
+func TestTavernAudioGrantSurvivesSignedRefresh(t *testing.T) {
+	original := &VideoGrant{RoomJoin: true, Room: "audio-test"}
+	original.SetTavernCanSubscribeAudio(false)
+	token, err := NewAccessToken("test-api-key", "test-secret-long-enough-for-signed-test").
+		SetIdentity("test-participant").SetVideoGrant(original).ToJWT()
+	require.NoError(t, err)
+	verifier, err := ParseAPIToken(token)
+	require.NoError(t, err)
+	_, claims, err := verifier.Verify("test-secret-long-enough-for-signed-test")
+	require.NoError(t, err)
+	require.False(t, claims.Video.GetTavernCanSubscribeAudio())
+	// RoomManager.refreshToken passes the participant's current Video grant.
+	refreshed, err := NewAccessToken("test-api-key", "test-secret-long-enough-for-signed-test").
+		SetIdentity(claims.Identity).SetVideoGrant(claims.Video.Clone()).ToJWT()
+	require.NoError(t, err)
+	verifier, err = ParseAPIToken(refreshed)
+	require.NoError(t, err)
+	_, claims, err = verifier.Verify("test-secret-long-enough-for-signed-test")
+	require.NoError(t, err)
+	require.NotNil(t, claims.Video.TavernCanSubscribeAudio)
+	require.False(t, *claims.Video.TavernCanSubscribeAudio)
+}
