+func TestTavernDelayedPermissionBindKeepsSubscriptionIntent(t *testing.T) {
+	for _, userUnsubscribed := range []bool{false, true} {
+		t.Run(fmt.Sprintf("userUnsubscribed=%v", userUnsubscribed), func(t *testing.T) {
+			sm := newTestSubscriptionManager()
+			defer sm.Close(false)
+			participant := sm.params.Participant.(*typesfakes.FakeLocalParticipant)
+			track := &typesfakes.FakeMediaTrack{}
+			track.KindReturns(livekit.TrackType_AUDIO)
+			track.IDReturns("audio")
+			sub := newMediaTrackSubscription("listener", "audio", logger.GetLogger())
+			sub.setDesired(true)
+			sm.subscriptions["audio"] = sub
+			track.AddSubscriberCalls(func(types.LocalParticipant) (types.SubscribedTrack, error) {
+				st := &typesfakes.FakeSubscribedTrack{}
+				st.MediaTrackReturns(track)
+				receiver := &sfufakes.FakeTrackReceiver{}
+				receiver.TrackIDReturns("audio")
+				listener := &sfufakes.FakeDownTrackListener{}
+				listener.OnDownTrackCloseCalls(func(resume bool) { setTestSubscribedTrackClosed(t, st, resume) })
+				dt, err := sfu.NewDownTrack(sfu.DownTrackParams{
+					Codecs:   []webrtc.RTPCodecParameters{{RTPCodecCapability: webrtc.RTPCodecCapability{MimeType: webrtc.MimeTypeOpus, ClockRate: 48000}}},
+					Receiver: receiver, Listener: listener, Logger: logger.GetLogger(), SubID: "listener",
+				})
+				require.NoError(t, err)
+				st.DownTrackReturns(dt)
+				t.Cleanup(func() { dt.CloseWithFlush(true, true) })
+				return st, nil
+			})
+			track.RemoveSubscriberCalls(func(livekit.ParticipantID, bool) {
+				if st := sub.getSubscribedTrack(); st != nil {
+					setTestSubscribedTrackClosed(t, st, false)
+				}
+			})
+			sm.params.TrackResolver = func(types.LocalParticipant, livekit.TrackID) types.MediaResolverResult {
+				return types.MediaResolverResult{Track: track, HasPermission: true}
+			}
+			require.NoError(t, sm.addSubscriber(sub, track, false))
+			first := sub.getSubscribedTrack().(*typesfakes.FakeSubscribedTrack)
+			participant.ClaimGrantsReturns(&auth.ClaimGrants{Video: &auth.VideoGrant{TavernCanSubscribeAudio: proto.Bool(false)}})
+			if userUnsubscribed {
+				sub.setDesired(false)
+			}
+			first.AddOnBindArgsForCall(0)(ErrNoSubscribePermission)
+			require.Eventually(t, func() bool { return sub.getSubscribedTrack() == nil }, time.Second, 10*time.Millisecond)
+			require.Equal(t, !userUnsubscribed, sub.isDesired(), "server permission denial must not replace the user's desired state")
+			participant.ClaimGrantsReturns(&auth.ClaimGrants{Video: &auth.VideoGrant{}})
+			if userUnsubscribed {
+				time.Sleep(80 * time.Millisecond)
+				require.Equal(t, 1, track.AddSubscriberCallCount())
+			} else {
+				sm.ReconcileAll()
+				require.Eventually(t, func() bool { return track.AddSubscriberCallCount() >= 2 }, time.Second, 10*time.Millisecond)
+				current := sub.getSubscribedTrack()
+				require.NotSame(t, first, current)
+				first.AddOnBindArgsForCall(0)(ErrNoSubscribePermission)
+				time.Sleep(40 * time.Millisecond)
+				require.Equal(t, 0, track.RemoveSubscriberCallCount(), "a late permission callback must never resolve a successor by participant ID")
+				require.Same(t, current, sub.getSubscribedTrack(), "an old bind callback must not close the replacement subscription")
+			}
+		})
+	}
+}
