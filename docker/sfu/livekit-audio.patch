+func TestTavernRealAudioCannotMasqueradeAsVideo(t *testing.T) {
+	server, finish := setupSingleNodeTestWithConfig(t.Name(), func(c *config.Config) {
+		c.Port = tavernPort
+		c.BindAddresses = []string{"127.0.0.1"}
+		c.RTC.NodeIP = rtcconfig.NodeIP{V4: "127.0.0.1"}
+		c.RTC.EnableLoopbackCandidate = true
+		c.RTC.IPs.Includes = []string{"127.0.0.0/8"}
+		c.RTC.UseExternalIP = false
+		c.RTC.STUNServers = []string{}
+		c.RTC.TCPPort = 0
+		c.RTC.UDPPort = rtcconfig.PortRange{Start: tavernPort + 2}
+	})
+	defer finish()
+	assertTavernAudioCapability(t)
+	grant := &auth.VideoGrant{RoomJoin: true, Room: testRoom}
+	grant.SetCanPublishSources([]livekit.TrackSource{livekit.TrackSource_CAMERA, livekit.TrackSource_SCREEN_SHARE})
+	publisher := createRTCClientWithToken(joinTokenWithGrant("tavern-kind", grant), tavernPort, testRTCServicePathv0, &testclient.Options{AutoSubscribe: true, TavernLoopbackOnly: true, SignalRequestInterceptor: func(message *livekit.SignalRequest, next testclient.SignalRequestHandler) error {
+		if request := message.GetAddTrack(); request != nil {
+			request.Source = livekit.TrackSource_CAMERA
+			if request.Cid == "mismatched-rtp" {
+				request.Type = livekit.TrackType_VIDEO
+				request.SimulcastCodecs = []*livekit.SimulcastCodec{{Cid: request.Cid, Codec: "video/vp8"}}
+			}
+		}
+		return next(message)
+	}})
+	defer publisher.Stop()
+	listener := createRTCClient("tavern-kind-listener", tavernPort, testRTCServicePathv0, &testclient.Options{AutoSubscribe: true, TavernLoopbackOnly: true})
+	defer listener.Stop()
+	waitUntilConnected(t, publisher, listener)
+	// A declaration that is itself inconsistent is rejected over real signaling.
+	writer, err := publisher.AddStaticTrack("audio/opus", "mislabelled-source", "camera")
+	require.Error(t, err)
+	require.Nil(t, writer)
+	room := server.RoomManager().GetRoom(context.Background(), testRoom)
+	require.NotNil(t, room)
+	native := room.GetParticipant("tavern-kind").(*rtc.ParticipantImpl)
+	require.Empty(t, native.GetPublishedTracks())
+	// Now announce a consistent VIDEO/CAMERA but negotiate a real Opus RTP track.
+	forged, err := publisher.AddStaticTrack("audio/opus", "mismatched-rtp", "camera")
+	require.NoError(t, err)
+	defer forged.Stop()
+	require.Eventually(t, native.TransportManager.IsPublisherEstablished, 5*time.Second, 20*time.Millisecond)
+	time.Sleep(500 * time.Millisecond)
+	require.Empty(t, native.GetPublishedTracks())
+	require.Zero(t, listener.TavernBytesFrom(publisher.ID()))
+	// A genuine VP8 camera from the same constrained publisher still forwards.
+	camera, err := publisher.AddStaticTrack("video/vp8", "genuine-camera", "camera")
+	require.NoError(t, err)
+	defer camera.Stop()
+	require.Eventually(t, func() bool { return listener.TavernBytesFrom(publisher.ID()) > 0 }, 5*time.Second, 20*time.Millisecond)
+	require.Len(t, native.GetPublishedTracks(), 1)
+	require.Equal(t, livekit.TrackType_VIDEO, native.GetPublishedTracks()[0].Kind())
+}
