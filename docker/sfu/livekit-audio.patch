+	track.KindReturns(livekit.TrackType_AUDIO)
+	track.IDReturns("audio")
+	st := &typesfakes.FakeSubscribedTrack{}
+	st.MediaTrackReturns(track)
+	track.AddSubscriberCalls(func(types.LocalParticipant) (types.SubscribedTrack, error) { close(entered); <-release; return st, nil })
+	sub := newMediaTrackSubscription(p.ID(), "audio", logger.GetLogger())
+	sm.subscriptions["audio"] = sub
+	go func() { finished <- sm.addSubscriber(sub, track, false) }()
+	<-entered
+	permission := p.ClaimGrants().Video.ToPermission()
+	permission.TavernCanSubscribeAudio = proto.Bool(false)
+	revoked := make(chan bool, 1)
+	go func() { revoked <- p.SetPermission(permission) }()
+	select {
+	case <-revoked:
+		t.Fatal("permission update missed an in-flight admission")
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(release)
+	require.NoError(t, <-finished)
+	require.True(t, <-revoked)
+	require.Equal(t, 1, track.RemoveSubscriberCallCount())
+	require.ErrorIs(t, sm.addSubscriber(sub, track, false), ErrNoSubscribePermission)
+	require.Equal(t, 1, track.AddSubscriberCallCount())
+}
