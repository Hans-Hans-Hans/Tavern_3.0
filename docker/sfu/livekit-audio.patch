+func TestTavernImmediateReusedTrackBindingKeepsBoundState(t *testing.T) {
+	sm := newTestSubscriptionManager()
+	defer sm.Close(false)
+	track := &typesfakes.FakeMediaTrack{}
+	track.IDReturns("reused-audio")
+	track.KindReturns(livekit.TrackType_AUDIO)
+	st := &typesfakes.FakeSubscribedTrack{}
+	st.MediaTrackReturns(track)
+	st.SubscriberReturns(sm.params.Participant)
+	track.AddSubscriberReturns(st, nil)
+	sub := newMediaTrackSubscription("listener", track.ID(), logger.GetLogger())
+	// Force the already-bound AddOnBind callback to finish before registration
+	// returns, reproducing the fastest possible reused-transceiver scheduling.
+	st.AddOnBindCalls(func(callback func(error)) {
+		require.Same(t, st, sub.getSubscribedTrack())
+		require.EqualValues(t, 1, sm.subscribedAudioCount.Load())
+		callback(nil)
+	})
+	require.NoError(t, sm.addSubscriber(sub, track, false))
+	require.True(t, sub.isBound(), "installing a reused admission must not reset its completed bind callback")
+	setTestSubscribedTrackClosed(t, st, false)
+	require.EqualValues(t, 0, sm.subscribedAudioCount.Load())
+}
