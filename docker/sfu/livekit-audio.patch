+	time.Sleep(400 * time.Millisecond)
+	require.Equal(t, beforeAudio, listener.TavernBytesFrom(microphone.ID()), "explicit resubscription and a newly published audio track remain denied")
+
+	// Older admin clients omit the extension on unrelated updates.
+	omitted := proto.Clone(updated.Permission).(*livekit.ParticipantPermission)
+	omitted.TavernCanSubscribeAudio = nil
+	omitted.CanPublishData = false
+	updated, err = rpc.UpdateParticipant(admin, &livekit.UpdateParticipantRequest{Room: testRoom, Identity: "tavern-listener", Permission: omitted})
+	require.NoError(t, err)
+	require.NotNil(t, updated.Permission.TavernCanSubscribeAudio)
+	require.False(t, *updated.Permission.TavernCanSubscribeAudio)
+	require.Eventually(t, func() bool {
