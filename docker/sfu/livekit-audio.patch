+			if track.Kind() == webrtc.RTPCodecTypeAudio {
+				return false
+			}
+		}
+		return len(native.GetPublishedTracks()) == 1
+	}, 5*time.Second, 20*time.Millisecond)
+	audioBefore, videoBefore := listener.TavernBytesFromKind(publisher.ID(), webrtc.RTPCodecTypeAudio), listener.TavernBytesFromKind(publisher.ID(), webrtc.RTPCodecTypeVideo)
+	time.Sleep(400 * time.Millisecond)
+	require.Equal(t, audioBefore, listener.TavernBytesFromKind(publisher.ID(), webrtc.RTPCodecTypeAudio))
+	require.Greater(t, listener.TavernBytesFromKind(publisher.ID(), webrtc.RTPCodecTypeVideo), videoBefore)
+	rejected, err := publisher.AddStaticTrack("audio/opus", "new-microphone", "microphone")
+	require.Error(t, err)
+	require.Nil(t, rejected)
+	require.Len(t, native.GetPublishedTracks(), 1)
+	require.Equal(t, livekit.TrackType_VIDEO, native.GetPublishedTracks()[0].Kind())
+	require.Equal(t, audioBefore, listener.TavernBytesFromKind(publisher.ID(), webrtc.RTPCodecTypeAudio))
+}
