+// Copyright 2026 Tavern contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+package rtc
+
+import (
+	"strings"
+
+	"github.com/livekit/livekit-server/pkg/rtc/types"
+	"github.com/livekit/protocol/livekit"
+	"github.com/pion/webrtc/v4"
+)
+
+// A source is signaled by the publisher. It is not evidence of the RTP kind.
+// UNKNOWN remains compatible with older clients, but does not pass a source
+// allowlist that contains only CAMERA and SCREEN_SHARE.
+func validTrackSourceKind(kind livekit.TrackType, source livekit.TrackSource) bool {
+	switch kind {
+	case livekit.TrackType_AUDIO:
+		return source == livekit.TrackSource_UNKNOWN || source == livekit.TrackSource_MICROPHONE || source == livekit.TrackSource_SCREEN_SHARE_AUDIO
+	case livekit.TrackType_VIDEO:
+		return source == livekit.TrackSource_UNKNOWN || source == livekit.TrackSource_CAMERA || source == livekit.TrackSource_SCREEN_SHARE
+	default:
+		return false
+	}
+}
+
+func validTrackRTPKind(kind livekit.TrackType, source livekit.TrackSource, negotiated webrtc.RTPCodecType, mimeType string) bool {
+	if !validTrackSourceKind(kind, source) {
+		return false
+	}
+	switch negotiated {
+	case webrtc.RTPCodecTypeAudio:
+		return kind == livekit.TrackType_AUDIO && strings.HasPrefix(strings.ToLower(mimeType), "audio/")
+	case webrtc.RTPCodecTypeVideo:
+		return kind == livekit.TrackType_VIDEO && strings.HasPrefix(strings.ToLower(mimeType), "video/")
+	default:
+		return false
+	}
+}
+
+func canSubscribeToMedia(participant types.LocalParticipant, kind livekit.TrackType) bool {
+	if !participant.CanSubscribe() {
+		return false
+	}
+	if kind == livekit.TrackType_VIDEO {
+		return true
+	}
+	if kind != livekit.TrackType_AUDIO {
+		return false
+	}
+	grants := participant.ClaimGrants()
+	return grants != nil && grants.Video != nil && grants.Video.GetTavernCanSubscribeAudio()
+}
