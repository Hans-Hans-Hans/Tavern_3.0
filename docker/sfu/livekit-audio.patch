+func TestTavernAudioSubscribeDeniesOrdinarySynchronousAndTransport(t *testing.T) {
+	sm := newTestSubscriptionManager()
+	defer sm.Close(false)
+	participant := sm.params.Participant.(*typesfakes.FakeLocalParticipant)
+	participant.ClaimGrantsReturns(&auth.ClaimGrants{Video: &auth.VideoGrant{TavernCanSubscribeAudio: proto.Bool(false)}})
+	track := &typesfakes.FakeMediaTrack{}
+	track.IDReturns("audio")
+	track.KindReturns(livekit.TrackType_AUDIO)
+	sm.params.TrackResolver = func(types.LocalParticipant, livekit.TrackID) types.MediaResolverResult {
+		return types.MediaResolverResult{Track: track, HasPermission: true}
+	}
+	sub := newMediaTrackSubscription("listener", "audio", logger.GetLogger())
+	require.ErrorIs(t, sm.subscribe(sub), ErrNoSubscribePermission)
+	require.ErrorIs(t, sm.subscribeSynchronous("audio"), ErrNoSubscribePermission)
+	require.Equal(t, 0, track.AddSubscriberCallCount())
+	require.True(t, canSubscribeToMedia(participant, livekit.TrackType_VIDEO))
+	participant.CanSubscribeReturns(false)
+	require.False(t, canSubscribeToMedia(participant, livekit.TrackType_VIDEO))
+
+	p := newParticipantForTest("tavern-subscribe")
+	permission := p.ClaimGrants().Video.ToPermission()
+	permission.TavernCanSubscribeAudio = proto.Bool(false)
+	p.SetPermission(permission)
+	audio, err := webrtc.NewTrackLocalStaticRTP(webrtc.RTPCodecCapability{MimeType: webrtc.MimeTypeOpus}, "audio", "stream")
+	require.NoError(t, err)
+	_, _, err = p.AddTrackLocal(audio, types.AddTrackParams{})
+	require.ErrorIs(t, err, ErrNoSubscribePermission)
+	_, _, err = p.AddTransceiverFromTrackLocal(audio, types.AddTrackParams{})
+	require.ErrorIs(t, err, ErrNoSubscribePermission)
+}
