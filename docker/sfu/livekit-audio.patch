+		c.RTC.UDPPort = rtcconfig.PortRange{Start: tavernPort + 2}
+	})
+	defer finish()
+	publisher := createRTCClient("tavern-active-publisher", tavernPort, testRTCServicePathv0, &testclient.Options{AutoSubscribe: true, TavernLoopbackOnly: true, SignalRequestInterceptor: func(message *livekit.SignalRequest, next testclient.SignalRequestHandler) error {
+		if request := message.GetAddTrack(); request != nil {
+			request.Source = livekit.TrackSource_CAMERA
+			if request.Type == livekit.TrackType_AUDIO {
+				request.Source = livekit.TrackSource_MICROPHONE
+			}
+		}
+		return next(message)
+	}})
+	defer publisher.Stop()
+	listener := createRTCClient("tavern-active-listener", tavernPort, testRTCServicePathv0, &testclient.Options{AutoSubscribe: true, TavernLoopbackOnly: true})
+	defer listener.Stop()
+	waitUntilConnected(t, publisher, listener)
+	microphone, err := publisher.AddStaticTrack("audio/opus", "microphone", "microphone")
+	require.NoError(t, err)
+	defer microphone.Stop()
+	camera, err := publisher.AddStaticTrack("video/vp8", "camera", "camera")
+	require.NoError(t, err)
+	defer camera.Stop()
+	require.Eventually(t, func() bool {
+		return listener.TavernBytesFromKind(publisher.ID(), webrtc.RTPCodecTypeAudio) > 0 && listener.TavernBytesFromKind(publisher.ID(), webrtc.RTPCodecTypeVideo) > 0
+	}, 5*time.Second, 20*time.Millisecond)
+	room := server.RoomManager().GetRoom(context.Background(), testRoom)
+	native := room.GetParticipant("tavern-active-publisher")
+	permission := native.ClaimGrants().Video.ToPermission()
+	permission.CanPublishSources = []livekit.TrackSource{livekit.TrackSource_CAMERA, livekit.TrackSource_SCREEN_SHARE}
+	rpc := livekit.NewRoomServiceJSONClient(fmt.Sprintf("http://127.0.0.1:%d", tavernPort), &http.Client{Timeout: 5 * time.Second})
+	_, err = rpc.UpdateParticipant(contextWithToken(adminRoomToken(testRoom)), &livekit.UpdateParticipantRequest{Room: testRoom, Identity: "tavern-active-publisher", Permission: permission})
+	require.NoError(t, err)
+	require.Eventually(t, func() bool {
