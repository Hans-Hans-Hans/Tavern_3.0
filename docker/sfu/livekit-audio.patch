+	require.Eventually(t, func() bool { return room.GetParticipant("tavern-listener") == nil }, 5*time.Second, 20*time.Millisecond)
+	resumed := createRTCClientWithToken(refreshed, tavernPort, testRTCServicePathv0, &testclient.Options{AutoSubscribe: true, TavernLoopbackOnly: true})
+	defer resumed.Stop()
+	waitUntilConnected(t, resumed)
+	require.Eventually(t, func() bool { return resumed.TavernBytesFrom(camera.ID()) > 0 }, 5*time.Second, 20*time.Millisecond)
+	time.Sleep(400 * time.Millisecond)
+	require.Zero(t, resumed.TavernBytesFrom(microphone.ID()), "refreshed reconnect must keep the audio restriction")
+	restored := room.GetParticipant("tavern-listener").ClaimGrants().Video.ToPermission()
+	restored.TavernCanSubscribeAudio = proto.Bool(true)
+	_, err = rpc.UpdateParticipant(admin, &livekit.UpdateParticipantRequest{Room: testRoom, Identity: "tavern-listener", Permission: restored})
+	require.NoError(t, err)
+	require.Eventually(t, func() bool { return resumed.TavernBytesFrom(microphone.ID()) > 0 }, 5*time.Second, 20*time.Millisecond)
+}
+
+// The configured internal SFU must positively identify the extension before a
+// gateway relies on it. Stock LiveKit's catch-all health response is not proof.
+func assertTavernAudioCapability(t *testing.T) {
+	t.Helper()
+	client := &http.Client{Timeout: 5 * time.Second}
+	endpoint := fmt.Sprintf("http://127.0.0.1:%d/tavern/sfu/audio-permissions", tavernPort)
+	response, err := client.Get(endpoint)
+	require.NoError(t, err)
+	body, err := io.ReadAll(io.LimitReader(response.Body, 128))
+	response.Body.Close()
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, response.StatusCode)
+	require.Equal(t, "application/json", response.Header.Get("Content-Type"))
+	require.Equal(t, "no-store", response.Header.Get("Cache-Control"))
+	require.Equal(t, `{"version":1}`, string(body))
+	request, err := http.NewRequest(http.MethodPost, endpoint, nil)
+	require.NoError(t, err)
+	response, err = client.Do(request)
+	require.NoError(t, err)
+	response.Body.Close()
+	require.Equal(t, http.StatusMethodNotAllowed, response.StatusCode)
+	require.Equal(t, "GET", response.Header.Get("Allow"))
+	response, err = client.Get(endpoint + "/not-the-capability")
+	require.NoError(t, err)
+	body, err = io.ReadAll(io.LimitReader(response.Body, 128))
+	response.Body.Close()
+	require.NoError(t, err)
+	require.NotEqual(t, `{"version":1}`, string(body))
+}
