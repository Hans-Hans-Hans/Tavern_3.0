+func TestTavernTrackSourceKind(t *testing.T) {
+	for _, kind := range []livekit.TrackType{livekit.TrackType_AUDIO, livekit.TrackType_VIDEO, livekit.TrackType_DATA, livekit.TrackType(999)} {
+		for _, source := range []livekit.TrackSource{livekit.TrackSource_UNKNOWN, livekit.TrackSource_MICROPHONE, livekit.TrackSource_CAMERA, livekit.TrackSource_SCREEN_SHARE, livekit.TrackSource_SCREEN_SHARE_AUDIO, livekit.TrackSource(999)} {
+			allowed := (kind == livekit.TrackType_AUDIO && (source == livekit.TrackSource_UNKNOWN || source == livekit.TrackSource_MICROPHONE || source == livekit.TrackSource_SCREEN_SHARE_AUDIO)) ||
+				(kind == livekit.TrackType_VIDEO && (source == livekit.TrackSource_UNKNOWN || source == livekit.TrackSource_CAMERA || source == livekit.TrackSource_SCREEN_SHARE))
+			require.Equal(t, allowed, validTrackSourceKind(kind, source), "kind=%s source=%s", kind, source)
+		}
+	}
+	grant := &auth.VideoGrant{}
+	grant.SetCanPublishSources([]livekit.TrackSource{livekit.TrackSource_CAMERA, livekit.TrackSource_SCREEN_SHARE})
+	require.False(t, grant.GetCanPublishSource(livekit.TrackSource_UNKNOWN))
+}
+
+func TestTavernAddTrackCannotPublishAudioAsCamera(t *testing.T) {
+	p := newParticipantForTest("tavern-publish")
+	permission := p.ClaimGrants().Video.ToPermission()
+	permission.CanPublishSources = []livekit.TrackSource{livekit.TrackSource_CAMERA, livekit.TrackSource_SCREEN_SHARE}
+	p.SetPermission(permission)
+	p.AddTrack(&livekit.AddTrackRequest{Cid: "forged-camera", Type: livekit.TrackType_AUDIO, Source: livekit.TrackSource_CAMERA})
+	p.AddTrack(&livekit.AddTrackRequest{Cid: "forged-screen", Type: livekit.TrackType_AUDIO, Source: livekit.TrackSource_SCREEN_SHARE})
+	require.Empty(t, p.pendingTracks)
+	p.AddTrack(&livekit.AddTrackRequest{Cid: "valid-camera", Type: livekit.TrackType_VIDEO, Source: livekit.TrackSource_CAMERA})
+	require.Contains(t, p.pendingTracks, "valid-camera")
+	_, mismatched, _, _, _ := p.getPendingTrack("valid-camera", livekit.TrackType_AUDIO, false)
+	require.Nil(t, mismatched, "an exact CID must not bypass negotiated kind")
+	_, valid, _, _, _ := p.getPendingTrack("valid-camera", livekit.TrackType_VIDEO, false)
+	require.NotNil(t, valid)
+	require.Nil(t, p.addMigratedTrack("forged-migration", &livekit.TrackInfo{Type: livekit.TrackType_AUDIO, Source: livekit.TrackSource_CAMERA}))
+}
+
+type tavernRemote struct {
+	sfu.TrackRemote
+	kind  webrtc.RTPCodecType
+	codec string
+}
+
+func (r tavernRemote) Kind() webrtc.RTPCodecType { return r.kind }
+func (r tavernRemote) Codec() webrtc.RTPCodecParameters {
+	return webrtc.RTPCodecParameters{RTPCodecCapability: webrtc.RTPCodecCapability{MimeType: r.codec}}
+}
+
+func TestTavernActualReceiverRejectsNegotiatedKindMismatch(t *testing.T) {
+	for _, c := range []struct {
+		declared livekit.TrackType
+		source   livekit.TrackSource
+		actual   webrtc.RTPCodecType
+		codec    string
+	}{
+		{livekit.TrackType_VIDEO, livekit.TrackSource_CAMERA, webrtc.RTPCodecTypeAudio, "audio/opus"},
+		{livekit.TrackType_AUDIO, livekit.TrackSource_CAMERA, webrtc.RTPCodecTypeAudio, "audio/opus"},
+		{livekit.TrackType_AUDIO, livekit.TrackSource_MICROPHONE, webrtc.RTPCodecTypeVideo, "video/VP8"},
+		{livekit.TrackType_VIDEO, livekit.TrackSource_CAMERA, webrtc.RTPCodecTypeVideo, "audio/opus"},
+		{livekit.TrackType_AUDIO, livekit.TrackSource_MICROPHONE, webrtc.RTPCodecTypeAudio, "video/VP8"},
+	} {
+		track := NewMediaTrack(MediaTrackParams{Logger: logger.GetLogger()}, &livekit.TrackInfo{Type: c.declared, Source: c.source})
+		// A nil buffer factory/receiver is deliberate: invalid transport must
+		// be rejected before any buffer or forwarding attachment is attempted.
+		codecAdded, receiverAdded := track.AddReceiver(nil, tavernRemote{kind: c.actual, codec: c.codec}, "test-mid")
+		require.False(t, codecAdded)
+		require.False(t, receiverAdded)
+	}
+	require.True(t, validTrackRTPKind(livekit.TrackType_AUDIO, livekit.TrackSource_MICROPHONE, webrtc.RTPCodecTypeAudio, "audio/opus"))
+	require.True(t, validTrackRTPKind(livekit.TrackType_VIDEO, livekit.TrackSource_CAMERA, webrtc.RTPCodecTypeVideo, "video/VP8"))
+}
