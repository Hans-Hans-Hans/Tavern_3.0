+		if grant == nil {
+			grant = &auth.VideoGrant{RoomJoin: true, Room: testRoom}
+		}
+		c := createRTCClientWithToken(joinTokenWithGrant(identity, grant), tavernPort, testRTCServicePathv0, &testclient.Options{AutoSubscribe: true, TavernLoopbackOnly: true})
+		t.Cleanup(c.Stop)
+		return c
+	}
+	microphone, camera, listener := client("tavern-audio", nil), client("tavern-video", nil), client("tavern-listener", nil)
+	waitUntilConnected(t, microphone, camera, listener)
+	audio, err := microphone.AddStaticTrack("audio/opus", "audio", "microphone")
+	require.NoError(t, err)
+	defer audio.Stop()
+	video, err := camera.AddStaticTrack("video/vp8", "video", "camera")
+	require.NoError(t, err)
+	defer video.Stop()
+	require.Eventually(t, func() bool {
+		return listener.TavernBytesFrom(microphone.ID()) > 0 && listener.TavernBytesFrom(camera.ID()) > 0
+	}, 5*time.Second, 20*time.Millisecond)
+	room := server.RoomManager().GetRoom(context.Background(), testRoom)
+	require.NotNil(t, room)
+	participant := room.GetParticipant("tavern-listener")
+	require.NotNil(t, participant)
+	permission := participant.ClaimGrants().Video.ToPermission()
+	permission.TavernCanSubscribeAudio = proto.Bool(false)
+	rpc := livekit.NewRoomServiceJSONClient(fmt.Sprintf("http://127.0.0.1:%d", tavernPort), &http.Client{Timeout: 5 * time.Second})
+	admin := contextWithToken(adminRoomToken(testRoom))
+	updated, err := rpc.UpdateParticipant(admin, &livekit.UpdateParticipantRequest{Room: testRoom, Identity: "tavern-listener", Permission: permission})
+	require.NoError(t, err)
+	require.NotNil(t, updated.Permission.TavernCanSubscribeAudio)
+	require.False(t, *updated.Permission.TavernCanSubscribeAudio)
+	require.Eventually(t, func() bool { return len(listener.SubscribedTracks()[microphone.ID()]) == 0 }, 5*time.Second, 20*time.Millisecond)
+	beforeAudio, beforeVideo := listener.TavernBytesFrom(microphone.ID()), listener.TavernBytesFrom(camera.ID())
+	time.Sleep(400 * time.Millisecond)
+	require.Equal(t, beforeAudio, listener.TavernBytesFrom(microphone.ID()), "revoked audio must stop actual RTP delivery")
+	require.Greater(t, listener.TavernBytesFrom(camera.ID()), beforeVideo, "video must continue delivering RTP")
+
+	// A malicious subscriber explicitly requests the audio track again.
+	audioTracks := room.GetParticipant("tavern-audio").GetPublishedTracks()
+	require.Len(t, audioTracks, 1)
+	require.NoError(t, listener.SendRequest(&livekit.SignalRequest{Message: &livekit.SignalRequest_Subscription{Subscription: &livekit.UpdateSubscription{TrackSids: []string{string(audioTracks[0].ID())}, Subscribe: true}}}))
+	secondAudio, err := microphone.AddStaticTrack("audio/opus", "second-audio", "screen-audio")
+	require.NoError(t, err)
