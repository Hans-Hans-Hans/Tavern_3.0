+func TestTavernAudioRevocationRemovesExistingAudioAndPreservesVideo(t *testing.T) {
+	p := newParticipantForTest("tavern-listener")
+	sm := p.SubscriptionManager
+	audio, video := &typesfakes.FakeMediaTrack{}, &typesfakes.FakeMediaTrack{}
+	audio.KindReturns(livekit.TrackType_AUDIO)
+	video.KindReturns(livekit.TrackType_VIDEO)
+	for id, track := range map[livekit.TrackID]*typesfakes.FakeMediaTrack{"audio": audio, "video": video} {
+		st := &typesfakes.FakeSubscribedTrack{}
+		st.MediaTrackReturns(track)
+		sub := newMediaTrackSubscription(p.ID(), id, logger.GetLogger())
+		sub.setSubscribedTrack(st)
+		sm.subscriptions[id] = sub
+	}
+	permission := p.ClaimGrants().Video.ToPermission()
+	permission.TavernCanSubscribeAudio = proto.Bool(false)
+	require.True(t, p.SetPermission(permission))
+	require.Equal(t, 1, audio.RemoveSubscriberCallCount())
+	require.Equal(t, 0, video.RemoveSubscriberCallCount())
+	omitted := p.ClaimGrants().Video.ToPermission()
+	omitted.TavernCanSubscribeAudio = nil
+	omitted.CanPublishData = false
+	require.True(t, p.SetPermission(omitted))
+	require.False(t, p.ClaimGrants().Video.GetTavernCanSubscribeAudio())
+	require.False(t, canSubscribeToMedia(p, livekit.TrackType_AUDIO))
+	require.True(t, canSubscribeToMedia(p, livekit.TrackType_VIDEO))
+}
