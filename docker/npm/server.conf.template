server {
    listen 8080;
    server_name ${TAVERN_DOMAIN};
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 12m;
    include /etc/nginx/tavern-headers.conf;
    set $matrix_upstream http://synapse:8008;
    set $tavern_api http://tavern-api:8090;
    set $managed_auth ${TAVERN_MANAGED_AUTH};
    proxy_http_version 1.1;
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
    proxy_buffering off;
    proxy_set_header Host ${TAVERN_DOMAIN};
    proxy_set_header X-Forwarded-Proto https;
    # Do not trust a browser-supplied forwarding chain. This records the NPM
    # peer address; account-based Synapse login throttles remain enabled.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_hide_header Server;
    set $integration_upstream http://integrations:8080;
    location ^~ /hooks/ {
        client_max_body_size 16k;
        limit_except POST { deny all; }
        proxy_pass $integration_upstream$request_uri;
    }
    set $rtc_sfu http://livekit:7880;
    location ^~ /element-call/ {
        include /etc/nginx/tavern-call-headers.conf;
        try_files $uri =404;
    }
    location = /.well-known/matrix/server {
        default_type application/json;
        return 200 '{"m.server":"${TAVERN_DOMAIN}:443"}';
    }
    location = /_matrix/federation/v1/openid/userinfo {
        error_log /dev/null;
        proxy_pass $matrix_upstream$request_uri;
    }
    location ~ "^/livekit/jwt/(get_token|sfu/get)$" {
        client_max_body_size 32k;
        limit_except POST { deny all; }
        rewrite ^/livekit/jwt/(.*)$ /api/calls/rtc-auth/$1 break;
        proxy_pass $tavern_api$uri$is_args$args;
    }
    location /livekit/jwt { return 404; }
    location = /_tavern/rtc-authorize {
        internal;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Tavern-RTC-URI $request_uri;
        proxy_set_header X-Tavern-RTC-Method $request_method;
        proxy_set_header X-Tavern-RTC-Upgrade $http_upgrade;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
        proxy_set_header Authorization $http_authorization;
        proxy_method GET;
        error_log /dev/null;
        proxy_pass $tavern_api/api/calls/sfu-authorize;
    }
    location ~ "^/livekit/sfu/rtc(?:/v1)?(?:/validate)?$" {
        auth_request /_tavern/rtc-authorize;
        # Authorize the query only; GET form bodies must not add SFU options.
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        rewrite ^/livekit/sfu/(.*)$ /$1 break;
        # SFU handshake URLs contain credentials. Keep them out of error logs.
        error_log /dev/null;
        proxy_set_header Host ${TAVERN_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cookie "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_pass $rtc_sfu$uri$is_args$args;
    }
    location /livekit/sfu { return 404; }
    location = /_matrix/push/v1/notify {
        client_max_body_size 32k;
        limit_except POST { deny all; }
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_pass $tavern_api$request_uri;
    }
    location = /health { return 200 'ok'; }
    location = /health/live { proxy_pass $tavern_api$request_uri; }
    location = /health/ready { proxy_pass $tavern_api$request_uri; }
    # Signed service callbacks use the private Docker network directly.
    location ^~ /api/internal/ { return 404; }
    location ^~ /api/ {
        # Keep the incoming proxy chain. The API trusts it only against the
        # explicitly configured proxy CIDRs; bootstrap otherwise fails closed.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Host ${TAVERN_DOMAIN};
        proxy_read_timeout 120s;
        proxy_pass $tavern_api$request_uri;
    }
    location = /tavern-config.json {
        default_type application/json;
        return 200 '{"homeserverUrl":"https://${TAVERN_DOMAIN}","lockHomeserver":true,"managedAuth":${TAVERN_MANAGED_AUTH},"serverRolePolicy":${TAVERN_ROLE_POLICY},"callsEnabled":${CALLS_ENABLED}}';
    }
    location = /.well-known/matrix/client {
        default_type application/json;
        include /etc/nginx/tavern-headers.conf;
        add_header Access-Control-Allow-Origin '*' always;
        return 200 '{"m.homeserver":{"base_url":"https://${TAVERN_DOMAIN}"},"org.matrix.msc4143.rtc_foci":[{"type":"livekit","livekit_service_url":"https://${TAVERN_DOMAIN}/livekit/jwt"}]}';
    }
    # Preserve the original encoded Matrix request URI.
    # Managed authentication must not be bypassed through native credential,
    # reset, or session-minting endpoints. Legacy static clients keep access.
    location ~ "^/_matrix/client/(?:api/v1|[^/]+)/(?:login|register|refresh|account/password|account/deactivate|account/3pid|pushers/set)(?:/|$)" {
        if ($managed_auth = true) { return 403; }
        proxy_pass $matrix_upstream$request_uri;
    }
    location /_matrix/client/ { proxy_pass $matrix_upstream$request_uri; }
    location ~ "^/_matrix/(?:media/(?:r0|v3)|client/[^/]+/media)/(?:upload|create)(?:/|$)" {
        if ($managed_auth = true) { return 403; }
        proxy_pass $matrix_upstream$request_uri;
    }
    location /_matrix/media/ { proxy_pass $matrix_upstream$request_uri; }
    location ^~ /_synapse/client/ { proxy_pass $matrix_upstream$request_uri; }
    location /_matrix { return 404; }
    location /_synapse { return 404; }
    location /.well-known/matrix/ { return 404; }
    location /assets/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
